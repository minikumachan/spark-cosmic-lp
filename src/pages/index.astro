      }
      .cform-status.err {
        color: #ff9b9b;
      }
      .cform-status.ok {
        color: #7fe0a0;
      }
      @media (max-width: 760px) {
        .contact-grid {
          grid-template-columns: 1fr;
          gap: 2.5rem;
        }
        .works li {
          grid-template-columns: 0.8rem 1fr;
        }
        .works .wtags {
          grid-column: 1 / -1;
          padding-left: 0;
        }
      }

      /* ── contact ── */
      .contact {
        min-height: 90vh; min-height: 90dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
      }
      .contact h2 {
        font-family: "Clash Display", "Zen Kaku Gothic New", sans-serif;
        font-weight: 900;
        font-size: clamp(2.4rem, 7vw, 5.5rem);
        line-height: 0.98;
        letter-spacing: -0.03em;
      }
      footer {
        border-top: 1px solid rgba(160, 175, 255, 0.14);
        padding: 3rem 0 9.5rem; /* 下は左下の時間の操作・右下の釦の高さぶん（いちばん下でも文字に重ねない） */
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        color: #8b93c4;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
      }

      /* ── Deck（スクロール段階遷移）。?scroll=free で無効化＝従来の自由スクロール。
         reduced-motion でも自動で free に退避するため、ドット等の付加 DOM は step 時のみ生成され
         品質計測（reduced-motion）には一切現れない。 ── */
      html.scroll-step {
        scroll-behavior: auto;
      }
      .deck-dots {
        position: fixed;
        right: clamp(0.85rem, 2.2vw, 1.7rem);
        top: 50%;
        transform: translateY(-50%);
        z-index: 40;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        align-items: center;
      }
      .deck-dot {
        width: 9px;
        height: 9px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: rgba(160, 175, 255, 0.3);
        cursor: pointer;
        transition:
          background 0.3s,
          box-shadow 0.3s,
          transform 0.3s;
      }
      .deck-dot:hover {
        background: rgba(160, 175, 255, 0.62);
      }
      .deck-dot[aria-current="true"] {
        background: #9db4ff;
        box-shadow: 0 0 11px rgba(127, 178, 255, 0.95);
        transform: scale(1.55);
      }
      @media (max-width: 760px) {
        .deck-dots {
          display: none;
        }
      }
      /* スマホでは左下の時間の操作と重なるので、scroll ↓ を少し上げる */
      @media (max-width: 640px) {
        .scrollhint {
          bottom: 5.6rem;
        }
        .hero {
          padding-bottom: 4rem;
        }
        footer {
          padding-bottom: 7rem;
        }
        html {
          scroll-padding-bottom: 5.5rem;
        }
      }
    </style>
  </head>
  <body>
