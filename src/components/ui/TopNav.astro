---
// 上の航路と相談の釦（最終発表で追加・2026-11-12 に決めた「上の航路と相談の釦」）。
// 中身は SSR のリンクなので、JS が無くても各節へ飛べる。JS は「いまどこか」の表示と step モードの経路だけを足す。
import { site, journey } from "../../lib/content";
const first = journey[0];
---

<nav class="tn" aria-label="ページ内の案内" data-tn>
  <div class="tn-in">
    <a class="tn-logo" href={first.href} data-stop="0" data-planet={first.planet} data-label={first.label}>{site.brand}</a>
    <button class="tn-here" type="button" aria-expanded="false" aria-controls="tn-list">
      <span class="tn-here-k">現在地</span>
      <span class="tn-here-v" data-here>{first.planet}・{first.label}</span>
      <svg class="tn-chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <ol class="tn-list" id="tn-list">
      {
        journey.map((s, i) => (
          <li>
            <a class="tn-stop" href={s.href} data-stop={i} data-planet={s.planet} data-label={s.label} aria-current={i === 0 ? "location" : undefined}>
              <span class="tn-pl">{s.planet}</span>
              <span class="tn-sc">{s.label}</span>
            </a>
          </li>
        ))
      }
      <li class="tn-li-help"><button type="button" class="tn-help-m" data-guide-open>使い方を見る</button></li>
    </ol>
    <button type="button" class="tn-help" data-guide-open>使い方</button>
    <a class="tn-cta" href={site.hero.primary.href}>{site.hero.primary.label}</a>
  </div>
  <div class="tn-prog" aria-hidden="true"><i data-prog></i></div>
</nav>
<p class="tn-arrive" aria-hidden="true" data-arrive><b></b><span></span></p>

<style>
  .tn {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 60px;
    background: linear-gradient(180deg, rgba(5, 6, 14, 0.88), rgba(5, 6, 14, 0.62));
    border-bottom: 1px solid rgba(160, 175, 255, 0.14);
    font-family: "Zen Kaku Gothic New", system-ui, sans-serif;
  }
  .tn-in {
    height: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3vw, 2.2rem);
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.6rem);
  }
  .tn-logo {
    font-family: "Clash Display", "Zen Kaku Gothic New", sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.01em;
    color: #fff;
    text-decoration: none;
    padding: 6px 2px;
  }
  .tn-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex: 1;
    justify-content: center;
    gap: clamp(0.9rem, 1.7vw, 1.7rem);
  }
  .tn-stop {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1px;
    padding: 9px 2px 11px;
    color: rgba(214, 221, 255, 0.64);
    text-decoration: none;
    white-space: nowrap;
    line-height: 1.35;
    transition: color 0.2s;
  }
  .tn-pl {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: rgba(157, 180, 255, 0.72);
  }
  .tn-sc {
    font-size: 0.84rem;
    font-weight: 500;
  }
  .tn-stop.is-past {
    color: rgba(226, 231, 255, 0.82);
  }
  .tn-stop:hover {
    color: #fff;
  }
  .tn-stop[aria-current] {
    color: #fff;
  }
  .tn-stop[aria-current] .tn-sc {
    font-weight: 700;
  }
  .tn-stop[aria-current] .tn-pl {
    color: #9db4ff;
  }
  .tn-stop[aria-current]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: #7fb2ff;
    box-shadow: 0 0 10px rgba(127, 178, 255, 0.8);
  }
  .tn-help,
  .tn-help-m {
    background: none;
    border: 0;
    color: rgba(214, 221, 255, 0.78);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    padding: 8px 4px;
    white-space: nowrap;
  }
  .tn-help:hover {
    color: #fff;
  }
  .tn-li-help {
    display: none;
  }
  .tn-cta {
    background: #2a64f6; /* 白い文字との差を 4.5 以上に（#2f6bff は 4.49 で足りない） */
    color: #fff;
    font-weight: 700;
    font-size: 0.86rem;
    padding: 0.62rem 1.2rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 26px rgba(47, 107, 255, 0.35);
    transition: background 0.2s;
  }
  .tn-cta:hover {
    background: #1f57e6;
  }
  .tn-logo:focus-visible,
  .tn-stop:focus-visible,
  .tn-help:focus-visible,
  .tn-help-m:focus-visible,
  .tn-here:focus-visible,
  .tn-cta:focus-visible {
    outline: 2px solid #9db4ff;
    outline-offset: 3px;
    border-radius: 8px;
  }
  .tn-cta:focus-visible {
    border-radius: 999px;
  }
  .tn-prog {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }
  .tn-prog i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #4f7dff, #9db4ff);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .tn-here {
    display: none;
  }

  /* 到着の表示（飾り。読み上げは aria-current が担う） */
  .tn-arrive {
    position: fixed;
    top: 76px;
    left: 50%;
    z-index: 55;
    margin: 0;
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    background: rgba(10, 14, 34, 0.8);
    border: 1px solid rgba(127, 178, 255, 0.35);
    color: #e6ebff;
    font-size: 0.86rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -6px);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  .tn-arrive b {
    color: #9db4ff;
  }
  .tn-arrive.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .tn-stop,
    .tn-arrive {
      transition: none;
    }
  }

  /* 狭い画面: 現在地と相談の釦だけを出し、航路は現在地を押すと開く */
  @media (max-width: 1023px) {
    .tn {
      height: 56px;
    }
    .tn-help {
      display: none;
    }
    .tn-here {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      column-gap: 0.4rem;
      align-items: center;
      flex: 1;
      min-width: 0;
      background: none;
      border: 0;
      color: #eef1ff;
      font: inherit;
      text-align: left;
      cursor: pointer;
      padding: 4px 2px;
    }
    .tn-here-k {
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      color: #9db4ff;
      grid-column: 1;
    }
    .tn-here-v {
      grid-column: 1;
      font-size: 0.84rem;
      font-weight: 700;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .tn-chev {
      grid-column: 2;
      grid-row: 1 / span 2;
      width: 12px;
      height: 12px;
      transition: transform 0.2s;
    }
    .tn[data-open] .tn-chev {
      transform: rotate(180deg);
    }
    .tn-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0.3rem clamp(1rem, 4vw, 1.6rem) 0.8rem;
      background: #070916; /* 透けると後ろの見出しが読めてしまう */
      border-bottom: 1px solid rgba(160, 175, 255, 0.16);
    }
    .tn[data-open] .tn-list {
      display: flex;
    }
    .tn-stop {
      grid-template-columns: 4.5em 1fr;
      justify-items: start;
      align-items: baseline;
      padding: 0.8rem 0.2rem;
      border-bottom: 1px solid rgba(160, 175, 255, 0.1);
    }
    .tn-pl {
      font-size: 0.74rem;
    }
    .tn-sc {
      font-size: 0.95rem;
    }
    .tn-stop[aria-current]::after {
      left: auto;
      right: 0.2rem;
      top: 50%;
      bottom: auto;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      transform: translateY(-50%);
    }
    .tn-li-help {
      display: block;
      padding-top: 0.4rem;
    }
    .tn-help-m {
      font-size: 0.88rem;
      padding: 0.6rem 0.2rem;
    }
    .tn-cta {
      font-size: 0.8rem;
      padding: 0.55rem 0.95rem;
    }
    .tn-arrive {
      top: 68px;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  type Deck = { mode?: string; goToStage?: (n: number) => void; getState?: () => { stage: number } };
  const nav = document.querySelector<HTMLElement>("[data-tn]");
  if (nav) {
    const stops = Array.from(nav.querySelectorAll<HTMLAnchorElement>(".tn-stop"));
    const here = nav.querySelector<HTMLElement>("[data-here]");
    const menuBtn = nav.querySelector<HTMLButtonElement>(".tn-here");
    const bar = nav.querySelector<HTMLElement>("[data-prog]");
    const arrive = document.querySelector<HTMLElement>("[data-arrive]");
    const deck = () => (window as unknown as { sparkDeck?: Deck }).sparkDeck;

    let cur = -1;
    let arriveTimer = 0;
    const setCurrent = (i: number, announce: boolean) => {
      if (!(i >= 0 && i < stops.length) || i === cur) return;
      const firstSet = cur < 0;
      cur = i;
      stops.forEach((a, k) => {
        if (k === i) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
        a.classList.toggle("is-past", k < i);
      });
      const planet = stops[i].dataset.planet ?? "";
      const label = stops[i].dataset.label ?? "";
      if (here) here.textContent = `${planet}・${label}`;
      if (arrive && announce && !firstSet) {
        const b = arrive.querySelector("b");
        const s = arrive.querySelector("span");
        if (b) b.textContent = `${planet}に到着`;
        if (s) s.textContent = label;
        arrive.classList.add("is-on");
        clearTimeout(arriveTimer);
        arriveTimer = window.setTimeout(() => arrive.classList.remove("is-on"), 2200);
      }
    };
    window.addEventListener("spark:stage", (e) => {
      const d = (e as CustomEvent<{ index?: number }>).detail;
      if (d && typeof d.index === "number") setCurrent(d.index, true);
    });
    const s0 = deck()?.getState?.().stage;
    setCurrent(typeof s0 === "number" && s0 >= 0 ? s0 : 0, false);

    // 進み具合の線（ページ全体のうちどこまで来たか）
    let raf = 0;
    const paint = () => {
      raf = 0;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (bar) bar.style.transform = `scaleX(${p})`;
    };
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(paint);
    };
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    paint();

    // 狭い画面の航路（現在地を押すと開く）
    const isOpen = () => nav.hasAttribute("data-open");
    const openMenu = () => {
      nav.setAttribute("data-open", "");
      menuBtn?.setAttribute("aria-expanded", "true");
    };
    const closeMenu = () => {
      nav.removeAttribute("data-open");
      menuBtn?.setAttribute("aria-expanded", "false");
    };
    menuBtn?.addEventListener("click", () => (isOpen() ? closeMenu() : openMenu()));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        closeMenu();
        menuBtn?.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (isOpen() && !nav.contains(e.target as Node)) closeMenu();
    });
    window.addEventListener("resize", () => {
      if (isOpen() && window.innerWidth > 1023) closeMenu();
    });

    // 停留所を押した時。通常スクロールはリンクのまま（スクロールは CSS の smooth、焦点も移る）。
    // step モードだけは段階遷移の係に渡す。
    nav.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("[data-guide-open]")) {
        closeMenu();
        return;
      }
      const a = t.closest<HTMLAnchorElement>("a[data-stop]");
      if (!a) return;
      closeMenu();
      const d = deck();
      if (d?.mode === "step" && d.goToStage) {
        e.preventDefault();
        d.goToStage(Number(a.dataset.stop));
      }
    });
  }
</script>
